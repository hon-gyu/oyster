; Generating notes from vault queries. Built on request, not by default: the
; rules shell out to minijinja-cli, which is not an OCaml dependency and may be
; absent.

(rule
 (targets index.md)
 (deps
  (source_tree .)
  index.md.jinja)
 (action
  (with-stdout-to
   index.md
   (pipe-stdout
    (run %{bin:oyster} context .)
    (run minijinja-cli --format=json index.md.jinja -)))))

(rule
 (targets tags.md)
 (deps
  (source_tree .)
  tags.md.jinja)
 (action
  (with-stdout-to
   tags.md
   (pipe-stdout
    (run %{bin:oyster} context .)
    (run minijinja-cli --format=json tags.md.jinja -)))))

(rule
 (targets health.md)
 (deps
  (source_tree .)
  health.md.jinja)
 (action
  (with-stdout-to
   health.md
   (pipe-stdout
    (run %{bin:oyster} context .)
    (run minijinja-cli --format=json health.md.jinja -)))))

(alias
 (name vault-site)
 (deps index.md tags.md health.md))

; Executing a code block from a note. The note owns the code; the build system
; runs it and merges the result into the template context.

(rule
 (targets context.json)
 (deps
  (source_tree .))
 (action
  (with-stdout-to
   context.json
   (run %{bin:oyster} context .))))

(rule
 (targets hydration.json)
 (deps sourdough.md)
 (action
  (with-stdout-to
   hydration.json
   (pipe-stdout
    (run
     %{bin:oyster}
     block
     sourdough.md
     "descend kind=code_block id=hydration lang=python"
     -print
     prop:text)
    (run uv run -)))))

(rule
 (targets hydration.md)
 (deps hydration.md.jinja context.json hydration.json)
 (action
  (with-stdout-to
   hydration.md
   (run
    minijinja-cli
    --format=json
    hydration.md.jinja
    context.json
    hydration.json))))

(alias
 (name vault-site-exec)
 (deps hydration.md))
